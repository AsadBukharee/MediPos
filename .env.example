# Production settings for docker-compose.yml / Coolify. Copy to .env and fill in.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Public host names (comma separated, no scheme) and origins (with scheme).
# Behind a tunnel, use the tunnel's hostname here (e.g. api-medipos.example.com).
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
# Regexes for origins whose name changes, such as Vercel preview deployments.
# Keep them narrow: CORS_ALLOWED_ORIGIN_REGEXES=^https://medipos-[a-z0-9-]+\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=
FRONTEND_URL=https://app.example.com
# The API URL the browser calls. Compiled into the web app at build time.
NEXT_PUBLIC_API_URL=https://api.example.com

# Cloudflare Tunnel token, only needed for the optional `cloudflared` service
# (docker compose --profile tunnel up -d cloudflared). See docs/DEPLOY.md.
CLOUDFLARE_TUNNEL_TOKEN=
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_BUSINESS_NAME=MediPos Pharmacy

TIME_ZONE=Asia/Karachi
# Set to 0 only when TLS is terminated somewhere that does not send X-Forwarded-Proto.
SECURE_SSL_REDIRECT=1

# Push notifications: put the Firebase service-account JSON in ./secrets/ and point at it here.
FIREBASE_CREDENTIALS_FILE=/run/medipos-secrets/firebase.json
SENTRY_DSN=
BACKUP_KEEP_DAYS=14
