# Base URL of the Django API (no trailing slash). 10.0.2.2 is the host machine from the Android emulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# A real device on the same Wi-Fi: your machine's LAN address, e.g. http://192.168.1.20:8000
# A tunnelled backend: its public HTTPS hostname. See docs/DEPLOY.md.
