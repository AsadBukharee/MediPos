# Copy to .env for local development (never commit the real file).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
# Add your machine's LAN address when a phone on the same Wi-Fi should reach this server,
# or a tunnel hostname when the API is exposed publicly. See docs/DEPLOY.md.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra browser origins matched by regex, for Vercel preview deployments and the like.
CORS_ALLOWED_ORIGIN_REGEXES=
DATABASE_URL=postgres://medipos:medipos@localhost:5432/medipos
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TIME_ZONE=Asia/Karachi
# Path to the Firebase service-account JSON. Leave empty to run without push notifications.
FIREBASE_CREDENTIALS_FILE=
SENTRY_DSN=
